# Kopiere diese Datei nach secrets.yaml und trage deine echten Werte ein.
# secrets.yaml sollte NIEMALS in Git eingecheckt werden (siehe .gitignore).

email: "deine-email@beispiel.de"

robot:
  # Die DUID findest du z. B. über check_device_model.py oder in der
  # Roborock-App / Home-Assistant-Integration.
  duid: "XXXXXXXXXXXXXXXXXXXXXX"

mqtt:
  broker: "192.168.178.148"
  port: 1883
  topic: "roborock/buksi/command"
  status_topic: "roborock/buksi/status"

# Reinigungseinstellungen. Alle Werte sind optional - fehlt ein Wert oder
# ist er ungültig, verwendet der Daemon den bisherigen Standard und
# schreibt eine Warnung mit den gültigen Optionen ins Log.
cleaning:
  # Reinigungsmodus. Optionen: VACUUM, MOP, VAC_AND_MOP
  clean_mode: "VACUUM"

  # Saugstufe. Optionen: OFF, QUIET, BALANCED, TURBO, MAX, MAX_PLUS
  fan_level: "TURBO"

  # EXPERIMENTELL, NICHT LIVE VERIFIZIERT: Reinigungslinien-Dichte
  # (vermutlich "einfach/doppelt"-Bahnen aus der App).
  # Optionen: FAST, DAILY, FINE
  # Leer lassen (oder null), um die aktuell in der App eingestellte
  # Dichte NICHT zu verändern - empfohlen, bis das Verhalten verifiziert ist.
  clean_line: null
