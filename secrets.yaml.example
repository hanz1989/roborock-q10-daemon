# Kopiere diese Datei zu secrets.yaml und trage deine echten Werte ein.
# secrets.yaml wird von .gitignore ausgeschlossen und NIEMALS committet.

email: "deine.email@example.com"
# Passwort wird beim ersten Login interaktiv abgefragt (OTP-Flow),
# danach in roborock_token.json persistiert - hier NICHT eintragen.

robot:
  name: "Buksi"                     # Anzeigename deines Geräts
  duid: "DEINE_DEVICE_DUID_HIER"    # aus der Roborock App / API
  model: "roborock.vacuum.ss07"
  local_key: "DEIN_LOCAL_KEY_HIER"  # aus der Roborock App / API, aktuell ungenutzt (kein lokales Control für B01/Q10)

mqtt:
  broker: "192.168.x.x"
  port: 1883
  topic: "roborock/buksi/command"
  username: ""                      # falls dein Broker Auth erfordert
  password: ""

rooms:
  # Room-IDs, wie in device.b01_q10_properties.map.rooms ermittelt
  Badezimmer: 9
  # Schlafzimmer: <ID>
  # Wohnzimmer: <ID>
  # Kueche: <ID>
